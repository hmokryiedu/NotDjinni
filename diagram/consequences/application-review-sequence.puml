@startuml Application Review Sequence

skinparam participant {
    BackgroundColor LightYellow
    BorderColor Gray
    FontSize 11
}

skinparam database {
    BackgroundColor LightGreen
    BorderColor DarkGreen
}

title NotDjinni - Application Status Update Sequence Diagram

actor "Employer" as Employer
participant "System" as System
database "Database" as DB

== Status Update Request ==

Employer -> System: Request status update\n(application_id, new_status)
activate System

== Get Employer Company ==

System -> DB: Verify employer company
activate DB
DB --> System: Company info retrieved
deactivate DB

alt Employer profile not found
    System --> Employer: Error: Employer profile not found
    deactivate System
end

== Verify Application ==

System -> DB: Retrieve application
activate DB
DB --> System: Application found
deactivate DB

alt Application not found
    System --> Employer: Error: Application not found
    deactivate System
end

== Check Authorization ==

System -> DB: Verify vacancy ownership
activate DB
DB --> System: Vacancy info retrieved
deactivate DB

System -> System: Verify employer authorized for vacancy
note right: Check if employer's company\nmatches vacancy's company

alt Unauthorized
    System --> Employer: Error: Not authorized
    deactivate System
end

== Update Application Status ==

System -> DB: Update status
activate DB
DB --> System: Status updated
deactivate DB

== Response ==

System --> Employer: Status updated successfully
deactivate System

note over Employer, DB
  Available status progressions:
  APPLIED → REVIEWING → INTERVIEW → OFFER → HIRED
                   \→ TEST_TASK ↗
  Any status → REJECTED or WITHDRAWN
end note

@enduml
