@startuml Job Application Sequence

skinparam participant {
    BackgroundColor LightYellow
    BorderColor Gray
    FontSize 11
}

skinparam database {
    BackgroundColor LightGreen
    BorderColor DarkGreen
}

title NotDjinni - Job Application Creation Sequence Diagram

actor "Job Seeker" as Seeker
participant "System" as System
database "Database" as DB

== Application Request ==

Seeker -> System: Submit application\n(vacancy_id, cover_letter)
activate System

== Verify Job Seeker Profile ==

System -> DB: Check if seeker profile exists
activate DB
DB --> System: Profile found
deactivate DB

alt Profile not found
    System --> Seeker: Error: Create profile first
    deactivate System
end

== Verify Vacancy ==

System -> DB: Check if vacancy exists
activate DB
DB --> System: Vacancy found
deactivate DB

alt Vacancy not found
    System --> Seeker: Error: Vacancy not found
    deactivate System
end

== Check for Duplicate Application ==

System -> DB: Check if already applied to vacancy
activate DB
DB --> System: No previous application
deactivate DB

alt Already applied
    System --> Seeker: Error: Already applied to this vacancy
    deactivate System
end

== Create Application ==

System -> DB: Record application
activate DB
DB --> System: Application created
deactivate DB

== Response ==

System --> Seeker: Application confirmed\nReceive application details
deactivate System

@enduml
