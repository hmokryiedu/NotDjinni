@startuml NotDjinni Use Case Diagram

skinparam usecase {
    BackgroundColor WhiteSmoke
    BorderColor Gray
    FontSize 12
}

skinparam actor {
    BackgroundColor LightBlue
    BorderColor Blue
    FontSize 14
}

' Actors
actor "Job Seeker" as JobSeeker
actor "Employer" as Employer

' Authentication
usecase "Register User" as Register
usecase "Login" as Login
usecase "Logout" as Logout

' Job Seeker use cases
usecase "Create Job Seeker\nProfile" as CreateJS
usecase "View Recommended\nVacancies\n(with Search)" as Recommended
usecase "Apply for Vacancy" as Apply
usecase "View My Applications" as ViewMyApps

' Employer use cases
usecase "Create Employer\nProfile" as CreateEmp
usecase "Post Vacancy" as Post
usecase "View My Vacancies" as ViewVacancies
usecase "View Applications" as ViewApps
usecase "Review Candidate\nProfile" as Review
usecase "Update Application\nStatus" as UpdateStatus

' Job Seeker connections
JobSeeker -- Register
JobSeeker -- Login
JobSeeker -- Logout
JobSeeker -- CreateJS
JobSeeker -- Recommended
JobSeeker -- Apply
JobSeeker -- ViewMyApps

' Employer connections
Employer -- Register
Employer -- Login
Employer -- Logout
Employer -- CreateEmp
Employer -- Post
Employer -- ViewVacancies
Employer -- ViewApps
Employer -- Review
Employer -- UpdateStatus

' Relationships
CreateJS .> Register : <<include>>
CreateEmp .> Register : <<include>>
Post .> Login : <<include>>
Apply .> Login : <<include>>
UpdateStatus ..> Review : <<extend>>

@enduml