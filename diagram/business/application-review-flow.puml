@startuml Application Review Flow

skinparam activity {
    BackgroundColor LightYellow
    BorderColor Gray
    FontSize 12
}

title NotDjinni - Application Review Flow

|Employer|
start
:Access applications;

if (Logged in?) then (yes)
    if (Has employer profile?) then (yes)
        :Select vacancy to review;

        if (Authorized to view vacancy?) then (yes)
            :View candidate applications;
            :Select application to review;
            :Read cover letter and\ncandidate profile;

            |Employer|
            switch (Update status?)
            case (Start reviewing)
                :Mark as reviewing;

            case (Schedule interview)
                :Mark for interview;

            case (Assign test task)
                :Mark test task assigned;

            case (Send offer)
                :Mark offer extended;

            case (Hire candidate)
                :Mark hired;

            case (Reject)
                :Reject application;

            endswitch

            |System|
            :Update application status;

            |Employer|
            :Status updated;
            stop

        else (no)
            |Employer|
            :Access denied;
            stop
        endif

    else (no)
        |Employer|
        :Create employer profile first;
        stop
    endif

else (no)
    |Employer|
    :Login;
    stop
endif

@enduml
