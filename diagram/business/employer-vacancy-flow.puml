@startuml Employer Vacancy Flow

skinparam activity {
    BackgroundColor LightYellow
    BorderColor Gray
    FontSize 12
}

title NotDjinni - Employer Vacancy Management Flow

|Employer|
start
:Access vacancy management;

if (Logged in?) then (yes)
    if (Has employer profile?) then (yes)
        :View company vacancies;

        |Employer|
        switch (Choose action?)
        case (Create vacancy)
            :Fill vacancy details\n(title, description, salary, etc.);
            :Set initial status;
            :Publish;

        case (Update vacancy)
            :Select vacancy;
            :Modify details;
            :Save;

        case (Change status)
            :Select vacancy;
            :Change status\n(ACTIVE/PAUSED/CLOSED);
            :Confirm;

        case (Delete vacancy)
            :Select vacancy;
            :Confirm deletion;

            |System|
            :Remove vacancy and\nrelated applications;

        endswitch

        |Employer|
        :View updated vacancy list;
        stop

    else (no)
        |Employer|
        :Create employer profile first;
        :Select company;
        :Save profile;
        stop
    endif

else (no)
    |Employer|
    :Login;
    stop
endif

@enduml
