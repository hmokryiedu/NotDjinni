@startuml User Registration Flow

skinparam activity {
    BackgroundColor LightYellow
    BorderColor Gray
    FontSize 12
}

title NotDjinni - User Registration Flow

|User|
start
:Enter email and password;
:Submit registration;

|System|
:Validate email format;

if (Valid email?) then (yes)
    :Check if email exists;

    if (Email already registered?) then (yes)
        |User|
        :Show error: Email already in use;
        stop
    else (no)
        |System|
        :Validate password strength;

        if (Strong password?) then (yes)
            :Secure password;
            :Create user account;
            :Generate authentication tokens;

            |User|
            :Receive tokens;
            :Go to dashboard;
            stop
        else (no)
            |User|
            :Show error: Password too weak;
            stop
        endif
    endif
else (no)
    |User|
    :Show error: Invalid email format;
    stop
endif

@enduml
