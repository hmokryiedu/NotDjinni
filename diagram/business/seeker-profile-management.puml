@startuml Seeker Profile Management Flow

skinparam activity {
    BackgroundColor LightYellow
    BorderColor Gray
    FontSize 12
}

title NotDjinni - Seeker Profile Management Flow

|Job Seeker|
start
:Access profile;

if (Logged in?) then (yes)
    :View profile;

    if (Profile exists?) then (yes)
        |Job Seeker|
        switch (Choose action?)
        case (Update profile)
            :Modify profile details;
            :Save changes;

        case (Manage experience)
            :Add, edit, or remove\nwork experience entries;
            :Save changes;

        case (Delete profile)
            :Confirm deletion;

            |System|
            :Remove profile and related data;

        endswitch

        |Job Seeker|
        :View updated profile;
        stop

    else (no)
        |Job Seeker|
        :Create new profile;
        :Enter personal information;
        :Add work experience;
        :Save;

        |System|
        :Store profile;

        |Job Seeker|
        :Profile created;
        stop
    endif

else (no)
    |Job Seeker|
    :Redirect to login;
    stop
endif

@enduml
