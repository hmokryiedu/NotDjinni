@startuml User Login Flow

skinparam activity {
    BackgroundColor LightYellow
    BorderColor Gray
    FontSize 12
}

title NotDjinni - User Login Flow

|User|
start
:Enter email and password;
:Submit login;

|System|
:Find user account;

if (Account exists?) then (yes)
    :Verify password;

    if (Password correct?) then (yes)
        :Generate authentication tokens;
        :Store session;

        |User|
        :Receive tokens;
        :Go to dashboard;
        stop
    else (no)
        |User|
        :Show error: Invalid credentials;
        stop
    endif
else (no)
    |User|
    :Show error: Invalid credentials;
    stop
endif

@enduml
