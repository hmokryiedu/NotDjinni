@startuml Job Application Flow

skinparam activity {
    BackgroundColor LightYellow
    BorderColor Gray
    FontSize 12
}

title NotDjinni - Job Application Flow

|Job Seeker|
start
:Browse and search vacancies;
:Select vacancy;

if (Logged in?) then (yes)
    if (Has seeker profile?) then (yes)
        :Check if already applied;

        if (Already applied?) then (yes)
            :Show: Already applied to this vacancy;
            stop
        else (no)
            :Write cover letter (optional);
            :Submit application;

            |System|
            :Record application;

            |Job Seeker|
            :See application confirmed;
            stop
        endif
    else (no)
        :Show: Create seeker profile first;
        stop
    endif
else (no)
    :Show: Login to apply;
    stop
endif

@enduml
