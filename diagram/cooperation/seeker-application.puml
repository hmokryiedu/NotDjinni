@startuml Job Seeker Application Cooperation

skinparam actor {
    BackgroundColor LightBlue
    BorderColor Blue
}

title NotDjinni - Job Seeker Application Cooperation

' ==================== ACTORS ====================
actor "Job Seeker" as JS
actor "Platform" as PLT
actor "Employer" as EMP

' ==================== COOPERATION FLOW ====================

JS -> PLT : "1. Create job seeker\nprofile with experience"
JS -> PLT : "2. Search and browse\nvacancies"
EMP -> PLT : "3. Employer posts\nvacancy"
PLT -> JS : "4. Display matching\nvacancies in results"

JS -> PLT : "5. Submit application\nwith cover letter"
PLT -> EMP : "6. Deliver application\nto employer"
EMP -> PLT : "7. Update application\nstatus"
PLT -> JS : "8. Notify: Status\nchanged to 'Reviewing'"

PLT -> JS : "9. Send interview\ninvitation from employer"
JS -> PLT : "10. Confirm interview\nattendance"
PLT -> EMP : "11. Confirm candidate\nwill attend interview"

EMP -> PLT : "12. Send job offer"
PLT -> JS : "13. Deliver job offer\ndetails"
JS -> PLT : "14. Accept or decline\noffer"

' ==================== NOTES ====================

note right of PLT
  Platform connects Job Seeker
  with Employers and facilitates
  the entire application and
  hiring workflow
end note

note bottom of JS
  Job Seeker manages their job search:
  - Creates profile
  - Searches vacancies
  - Applies to positions
  - Tracks applications
  - Responds to offers
end note

note bottom of EMP
  Employer participates in
  the application process and
  interacts with candidates
end note

@enduml
