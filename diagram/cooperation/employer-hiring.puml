@startuml Employer Hiring Cooperation

skinparam actor {
    BackgroundColor LightBlue
    BorderColor Blue
}

title NotDjinni - Employer Hiring Cooperation

' ==================== ACTORS ====================
actor "Employer" as EMP
actor "Platform" as PLT
actor "Job Seeker" as JS

' ==================== COOPERATION FLOW ====================

EMP -> PLT : "1. Create employer\nprofile with company"
EMP -> PLT : "2. Post job vacancy"
JS -> PLT : "3. Submit application"
PLT -> EMP : "4. Notify: Application\nreceived"

EMP -> PLT : "5. Review application\ndetails"
EMP -> PLT : "6. Request interview\nwith candidate"
PLT -> JS : "7. Invite to\ninterview"
JS -> PLT : "8. Accept\ninterview"

PLT -> EMP : "9. Confirm interview\nscheduled"
EMP -> PLT : "10. Send job offer\nto candidate"
PLT -> JS : "11. Deliver offer"
JS -> PLT : "12. Accept offer"

PLT -> EMP : "13. Confirm: Offer\naccepted, hire candidate"

' ==================== NOTES ====================

note right of PLT
  Platform connects Employer
  with qualified candidates
  and facilitates the entire
  hiring workflow
end note

note bottom of EMP
  Employer manages the hiring process:
  - Posts vacancies
  - Reviews applications
  - Conducts interviews
  - Makes job offers
end note

note bottom of JS
  Job Seeker participates in
  the hiring process and
  responds to invitations
end note

@enduml
