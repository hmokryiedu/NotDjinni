@startuml NotDjinni System Architecture

skinparam component {
    BackgroundColor LightYellow
    BorderColor Gray
    FontSize 11
}

skinparam package {
    BackgroundColor WhiteSmoke
    BorderColor Gray
}

skinparam database {
    BackgroundColor LightGreen
    BorderColor DarkGreen
}

title NotDjinni - System Architecture (3-Tier Component Diagram)

' ==================== CLIENT TIER ====================
package "Client" {
    component [Browser] as Browser
}

' ==================== WEB SERVER TIER ====================
package "Web Server" {
    component [Administrative Module] as AdminModule
    component [User Module] as UserModule
    component [API] as API

    AdminModule --> API : internal API calls
    UserModule --> API : internal API calls
}

' ==================== DATABASE SERVER TIER ====================
package "Database Server" {
    database [Database] as DB
}

' ==================== CONNECTIONS ====================

Browser --> AdminModule : HTTP/HTTPS
Browser --> UserModule : HTTP/HTTPS
API --> DB : SQL queries

@enduml
